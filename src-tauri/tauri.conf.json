{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nav Toolbox",
  "version": "0.1.1",
  "identifier": "dev.navtoolbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nav Toolbox",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#dceaff"
      },
      {
        "label": "popup",
        "title": "Nav Toolbox Launcher",
        "url": "/?view=popup",
        "width": 500,
        "height": 660,
        "minWidth": 360,
        "minHeight": 320,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#dceaff",
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "rpm",
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Quick commands at your fingertips",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
