{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nav Toolbox",
  "version": "0.1.0",
  "identifier": "dev.navtoolbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Nav Toolbox", "width": 1280, "height": 840, "minWidth": 900, "minHeight": 620, "center": true, "backgroundColor": "#dceaff" },
      { "label": "popup", "title": "Nav Toolbox Launcher", "url": "/?view=popup", "width": 500, "height": 660, "minWidth": 420, "minHeight": 520, "center": true, "visible": false, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "backgroundColor": "#dceaff" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Quick commands at your fingertips",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
